# Copy to .env and fill in. .env is git-ignored – never commit real keys.

# Server-side key: Geocoding API, Address Validation API, Solar API.
# In Cloud Console restrict it to exactly those 3 APIs (and to your server IP when deployed).
GOOGLE_MAPS_SERVER_KEY=

# Browser key: Maps JavaScript API + Places API (New). Restrict to HTTP referrers
# (e.g. http://localhost:3000/*, https://your-domain/*).
GOOGLE_MAPS_BROWSER_KEY=

# Optional: one key for both jobs (dev only – the UI will show a warning).
# GOOGLE_MAPS_API_KEY=

# Map ID (vector map, required for Advanced Markers). DEMO_MAP_ID works for development.
GOOGLE_MAP_ID=DEMO_MAP_ID

# Your Google Cloud project number – used to flag keys from the wrong project.
GOOGLE_CLOUD_PROJECT_NUMBER=31967172109

# Set false to skip Address Validation (one fewer billable call per text lookup).
USE_ADDRESS_VALIDATION=true

# Per-day request caps enforced by this app (protects your $25 budget).
DAILY_LIMIT_SOLAR=20
DAILY_LIMIT_GEOCODE=100
DAILY_LIMIT_ADDRESS_VALIDATION=50

PORT=3000
